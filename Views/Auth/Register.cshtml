@{
    ViewData["Title"] = "Register";
}
<h1>@ViewData["Title"]</h1>

@model User

<h2>Регистрация</h2>

<form asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div>
        <label asp-for="UserName">Имя пользователя</label>
        <input asp-for="UserName" />
        <span asp-validation-for="UserName"></span>
    </div>
    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="PasswordHash">Пароль</label>
        <input asp-for="PasswordHash" type="password" />
        <span asp-validation-for="PasswordHash"></span>
    </div>
    <div>
        <label asp-for="Role">Role</label>
        <input asp-for="Role" />
        <span asp-validation-for="Role"></span>
    </div>
    <button type="submit">Зарегистрироваться</button>
</form>

